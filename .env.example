# Telegram Bot API — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ID канала (обычно вида -100…). Бот должен быть админом канала с правом постить.
TELEGRAM_CHANNEL_ID=-1001234567890

# Домен для Caddy / Let's Encrypt
DOMAIN=расим-и-анна.рф

# Secure-флаг cookie (true в проде с HTTPS)
COOKIE_SECURE=true
