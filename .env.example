# Telegram Bot API — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ID группы (обычно вида -100…). Бот должен быть добавлен в группу.
# TELEGRAM_CHANNEL_ID всё ещё поддерживается как fallback.
TELEGRAM_CHAT_ID=-1001234567890

# Домен для Caddy / Let's Encrypt
DOMAIN=расим-и-анна.рф

# Secure-флаг cookie (true в проде с HTTPS)
COOKIE_SECURE=true
